{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentprocess.io/schemas/core-2/process-document.json",
  "title": "process-document",
  "description": "agentprocess core-2 shared shape: process-document",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "date",
              "datetime",
              "list",
              "object",
              "person"
            ]
          },
          {
            "$ref": "#/$defs/__schema0"
          }
        ]
      }
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "approve": {
            "type": "string"
          },
          "wait": {
            "type": "string"
          },
          "wait_until": {
            "type": "string"
          },
          "wait_for": {
            "type": "string"
          },
          "finish": {
            "type": "string"
          },
          "parallel": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "boolean",
                    "date",
                    "datetime",
                    "list",
                    "object",
                    "person"
                  ]
                },
                {
                  "$ref": "#/$defs/__schema0"
                }
              ]
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "file",
                "link"
              ]
            }
          },
          "next": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "to": {
                          "type": "string"
                        },
                        "when": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            ]
          },
          "person": {
            "type": "string"
          },
          "on_reject": {
            "type": "string"
          },
          "due": {
            "type": "string"
          },
          "timeout": {
            "type": "string"
          },
          "on_timeout": {
            "type": "string"
          },
          "check": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ask": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pass": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "fail": {
                      "type": "number"
                    },
                    "one_of": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "unsure": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "levels": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "ask"
                  ],
                  "additionalProperties": false
                }
              }
            ]
          },
          "advisory": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "data_sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "operations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "write"
              ]
            }
          },
          "resources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "key",
          "operations"
        ],
        "additionalProperties": false
      }
    },
    "emails": {
      "type": "object",
      "properties": {
        "templates": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "recipients": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^@[^\\s@]+\\.[^\\s@]+$"
          }
        }
      },
      "required": [
        "templates"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "description",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "number",
            "boolean",
            "date",
            "datetime",
            "list",
            "object",
            "person"
          ]
        },
        "description": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "one_of": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "items": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "string",
                "number",
                "boolean",
                "date",
                "datetime",
                "list",
                "object",
                "person"
              ]
            },
            {
              "$ref": "#/$defs/__schema0"
            }
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    }
  }
}
