{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentprocess.io/schemas/core-2/tools/submit.arguments.json",
  "title": "submit arguments",
  "description": "Arguments of the agentprocess tool submit",
  "type": "object",
  "properties": {
    "token": {
      "type": "string"
    },
    "output": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "link"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "next": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "maxLength": 4000
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "token",
    "output",
    "summary",
    "requestId"
  ],
  "additionalProperties": false
}
